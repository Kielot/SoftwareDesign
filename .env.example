# BICpES Learning Hub — Environment Configuration
# Copy this to .env and fill in your actual values

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ══════════════════════════════════════════════════════════════════════════════
# Visit https://supabase.com to create a free account and database

DB_TYPE=postgres
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-supabase-password
DB_NAME=postgres
DB_CHARSET=utf8

# Alternative: Local development (MySQL/XAMPP)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=bicpes_hub
# DB_CHARSET=utf8mb4

# ══════════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ══════════════════════════════════════════════════════════════════════════════

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.vercel.app

# ══════════════════════════════════════════════════════════════════════════════
# SESSION CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict
